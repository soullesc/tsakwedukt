---
import Logo from './Logo.astro';

const navItems = [
  { name: 'Home', url: '/' },
  { 
    name: 'Historia', 
    url: '/historia', 
    dropdown: [
      { name: 'O klubie', url: '/historia/o-klubie', icon: 'ti-building-monument' },
      { name: 'Zarząd', url: '/historia/zarzad', icon: 'ti-users' }
    ] 
  },
  { name: 'Wyniki', url: '/wyniki'},
  { name: 'Galeria', url: '/galeria' },
  { name: 'Trenerzy', url: '/trenerzy' },
  { name: 'Medaliści', url: '/medalisc' },
  { name: 'Kontakt', url: '/kontakt' },
];
---

<header class="bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-gray-100 transition-all duration-300">
  <div class="container mx-auto px-4 lg:px-8 max-w-[1400px] h-20 flex items-center justify-between">
    
    <a href="/" class="flex items-center group z-50 transition-opacity hover:opacity-90" aria-label="Strona główna">
      <Logo />
    </a>
    
    <nav class="hidden lg:flex items-center gap-1 xl:gap-3">
      {navItems.map((item) => (
        <div class="relative group">
          <a 
            href={item.url} 
            class="flex items-center gap-1.5 px-3 xl:px-4 py-2 rounded-full text-[13px] xl:text-sm font-bold text-gray-600 uppercase tracking-wide hover:bg-gray-50 hover:text-blue-600 transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
          >
            {item.name}
            {item.dropdown && (
              <i class="ti ti-chevron-down text-gray-400 group-hover:text-blue-500 group-hover:rotate-180 transition-transform duration-300 text-base"></i>
            )}
          </a>

          {item.dropdown && (
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-4 hidden group-hover:block z-50">
              <div class="min-w-[240px] bg-white border border-gray-100 shadow-xl rounded-2xl p-2 transform origin-top opacity-0 scale-95 group-hover:opacity-100 group-hover:scale-100 transition-all duration-200">
                <ul class="flex flex-col space-y-1">
                  {item.dropdown.map((dropItem) => (
                    <li>
                      <a 
                        href={dropItem.url} 
                        class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors group/link"
                      >
                        {dropItem.icon && (
                          <div class="w-8 h-8 rounded-lg bg-white border border-gray-100 shadow-sm flex items-center justify-center text-gray-400 group-hover/link:bg-blue-600 group-hover/link:text-white group-hover/link:border-blue-600 transition-all">
                            <i class={`ti ${dropItem.icon} text-lg`}></i>
                          </div>
                        )}
                        {dropItem.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>
    
    <button 
      id="mobile-menu-btn"
      class="lg:hidden relative w-10 h-10 flex items-center justify-center rounded-xl bg-gray-50 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-colors focus:outline-none z-50 ml-4"
      aria-label="Toggle menu"
    >
      <i id="icon-open" class="ti ti-menu-2 text-2xl absolute transition-all duration-300 transform scale-100 rotate-0"></i>
      <i id="icon-close" class="ti ti-x text-2xl absolute transition-all duration-300 transform scale-0 rotate-90 opacity-0"></i>
    </button>
  </div>

  <div 
    id="mobile-menu" 
    class="fixed inset-x-0 top-[80px] bg-white/95 backdrop-blur-xl border-t border-gray-100 shadow-2xl h-[calc(100vh-80px)] overflow-y-auto transform -translate-y-full opacity-0 pointer-events-none transition-all duration-300 z-40 lg:hidden"
  >
    <nav class="flex flex-col px-6 py-8 space-y-2 max-w-md mx-auto">
      {navItems.map((item) => (
        <div class="border-b border-gray-100 last:border-none pb-2 last:pb-0">
          <a 
            href={item.url} 
            class="flex items-center justify-between py-4 text-lg font-black text-gray-900 uppercase tracking-widest hover:text-blue-600 transition-colors"
          >
            {item.name}
          </a>
          
          {item.dropdown && (
            <div class="pl-4 flex flex-col space-y-1 pb-4">
              {item.dropdown.map((dropItem) => (
                <a 
                  href={dropItem.url} 
                  class="flex items-center gap-3 px-4 py-3 rounded-xl text-base font-medium text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors"
                >
                  {dropItem.icon && <i class={`ti ${dropItem.icon} text-blue-500 text-xl`}></i>}
                  {dropItem.name}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    let isOpen = false;

    if (btn && menu && iconOpen && iconClose) {
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        isOpen = !isOpen;

        if (isOpen) {
          menu.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
          iconOpen.classList.replace('scale-100', 'scale-0');
          iconOpen.classList.replace('rotate-0', '-rotate-90');
          iconOpen.classList.replace('opacity-100', 'opacity-0');
          iconClose.classList.replace('scale-0', 'scale-100');
          iconClose.classList.replace('rotate-90', 'rotate-0');
          iconClose.classList.replace('opacity-0', 'opacity-100');
          document.body.classList.add('overflow-hidden');
        } else {
          menu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
          iconOpen.classList.replace('scale-0', 'scale-100');
          iconOpen.classList.replace('-rotate-90', 'rotate-0');
          iconOpen.classList.replace('opacity-0', 'opacity-100');
          iconClose.classList.replace('scale-100', 'scale-0');
          iconClose.classList.replace('rotate-0', 'rotate-90');
          iconClose.classList.replace('opacity-100', 'opacity-0');
          document.body.classList.remove('overflow-hidden');
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initMobileMenu);
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
---
interface Props {
  title: string;
  subtitle: string;
  badgeText: string;
  icon: string; 
}

const { title, subtitle, badgeText, icon } = Astro.props;
---

<section class="py-16 md:py-20 bg-gray-900 text-white overflow-hidden relative rounded-b-[3rem] md:rounded-b-[5rem] rounded-tl-[3rem] rounded-tr-[3rem] border-b border-gray-800">
  <div class="container mx-auto px-4 relative z-10 text-center max-w-4xl">
    <div class="inline-flex items-center gap-2 bg-blue-500/20 text-blue-300 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest mb-6 border border-blue-500/30">
      <i class={`ti ${icon} text-lg`}></i> {badgeText}
    </div>
    
    <h1 class="text-4xl md:text-6xl font-black leading-none uppercase tracking-tighter mb-6 italic" set:html={title}>
    </h1>
    
    <p class="text-lg md:text-xl text-gray-400 font-medium leading-relaxed">
      {subtitle}
    </p>
  </div>
  
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-blue-600/20 rounded-full blur-[120px] pointer-events-none"></div>
</section>
---
import MedalBadge from './MedalBadge.astro';
const { ach } = Astro.props;
---
<div class="bg-slate-50 p-10 rounded-[2.5rem] border border-slate-100 relative overflow-hidden group hover:-translate-y-2 hover:shadow-2xl transition-all duration-500 text-left">
  <div class="text-xs font-black text-blue-600 uppercase tracking-[0.2em] mb-4">{ach.disc}</div>
  <h3 class="text-2xl font-black text-slate-900 mb-6 uppercase italic leading-tight">{ach.title}</h3>
  <p class="text-slate-500 text-sm font-bold mb-8 uppercase tracking-wide">{ach.team}</p>
  
  <div class="flex items-center gap-3">
    <span class="text-[10px] font-black uppercase text-slate-400">Wynik:</span>
    <MedalBadge medal={ach.result} />
  </div>
  <div class="absolute -bottom-4 -right-4 opacity-[0.03] text-9xl font-black italic select-none">#1</div>
</div>
---
interface Props {
  title: string;
  date: Date;
  author: string;
  excerpt: string;
  image: string;
  url: string;
}

const { title, date, author, excerpt, image, url } = Astro.props;

// Format daty
const day = date.getDate();
const month = date.toLocaleString('pl-PL', { month: 'short' }).substring(0, 3);
---

<article class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-gray-100 flex flex-col sm:flex-row gap-6 hover:shadow-md transition-all group relative">
  <div class="sm:w-1/3 xl:w-1/4 shrink-0">
    <div class="aspect-video sm:aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 relative">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
      />
      <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-md shadow-sm border border-white/20 flex flex-col items-center justify-center leading-none min-w-[3rem]">
        <span class="text-lg font-black text-gray-900">{day}</span>
        <span class="text-[10px] font-bold text-gray-500 uppercase">{month}</span>
      </div>
    </div>
  </div>
  
  <div class="sm:w-2/3 xl:w-3/4 flex flex-col py-1">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs text-gray-500 font-bold uppercase tracking-widest bg-gray-50 border border-gray-100 px-3 py-1 rounded-lg">
        <i class="ti ti-user mr-1 text-blue-500"></i> {author}
      </span>
    </div>
    
    <h3 class="text-xl md:text-2xl font-black uppercase tracking-tight text-gray-900 mb-3 leading-snug group-hover:text-blue-600 transition-colors">
      <a href={url} class="before:absolute before:inset-0">
        {title}
      </a>
    </h3>
    
    <p class="text-gray-600 line-clamp-3 mb-4 text-sm md:text-base font-medium">
      {excerpt}
    </p>
    
    <div class="mt-auto pt-4 border-t border-gray-50 relative z-10">
      <a href={url} class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-widest text-blue-600 hover:text-blue-800 transition-colors group-hover:translate-x-1 duration-200">
        Czytaj dalej
        <i class="ti ti-arrow-right text-lg"></i>
      </a>
    </div>
  </div>
</article>
---
// src/components/ContactInfoItem.astro
interface Props {
  icon: string;
  label: string;
  value: string;
  href?: string;
}

const { icon, label, value, href } = Astro.props;
---

<div class="flex items-start gap-4">
  <div class="bg-blue-600/20 w-12 h-12 flex items-center justify-center rounded-xl text-blue-400 mt-1 shrink-0">
    <i class={`ti ti-${icon} text-2xl`}></i>
  </div>
  <div>
    <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1">{label}</h3>
    {href ? (
      <a href={href} class="text-lg font-medium hover:text-blue-400 transition-colors">{value}</a>
    ) : (
      <p class="text-lg font-medium whitespace-pre-line" set:html={value}></p>
    )}
  </div>
</div>
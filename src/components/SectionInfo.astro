---
// src/components/SectionInfo.astro
interface Props {
  title?: string;
  blueTitle?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const { 
  title = "Potrzebujesz", 
  blueTitle = "informacji?", 
  description = "Masz pytania dotyczące współpracy? Nasz zarząd jest do Twojej dyspozycji.",
  buttonText = "Skontaktuj się",
  buttonHref = "/kontakt"
} = Astro.props;
---

<section class="container mx-auto px-4 mb-12">
    <div class="bg-gray-900 rounded-[2rem] p-10 md:p-12 text-center relative overflow-hidden shadow-xl border border-gray-800">
        <h2 class="text-3xl md:text-4xl font-black text-white uppercase tracking-tighter mb-4 italic">
            {title} <span class="text-blue-500">{blueTitle}</span>
        </h2>
        <p class="text-gray-400 max-w-lg mx-auto mb-8 text-base">
            {description}
        </p>
        <a href={buttonHref} class="inline-flex items-center gap-3 bg-white text-gray-900 px-8 py-4 rounded-xl font-black uppercase tracking-widest text-xs hover:bg-blue-600 hover:text-white transition-all duration-300">
            {buttonText}
        </a>
        
        <div class="absolute -bottom-24 -right-24 w-64 h-64 bg-blue-600/20 rounded-full blur-[80px] pointer-events-none"></div>
    </div>
</section>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactInfoItem from '../components/ContactInfoItem.astro';
import LocationCard from '../components/LocationCard.astro';
import ContactForm from '../components/ContactForm.astro'; 
---

<BaseLayout title="Kontakt - TS Akwedukt">
  <section class="py-16 bg-white overflow-hidden">
    <div class="container mx-auto px-4 relative z-10 text-left max-w-6xl">
      <span class="text-blue-600 font-bold uppercase tracking-[0.3em] text-[10px] mb-4 block">Zostańmy w kontakcie</span>
      <h1 class="text-6xl md:text-8xl font-black text-gray-900 leading-none uppercase tracking-tighter mb-6 italic">
        Napisz <br/><span class="text-blue-600">do nas.</span>
      </h1>
      <p class="text-xl text-gray-500 font-medium leading-relaxed max-w-2xl border-l-4 border-blue-600 pl-6">
        Masz pytania dotyczące treningów, chcesz dołączyć do klubu lub nawiązać współpracę? Jesteśmy do Twojej dyspozycji.
      </p>
    </div>
  </section>

  <section class="py-16 bg-gray-50/50">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-16">
        
        <div class="w-full lg:w-6/12">
          <div class="bg-gray-900 rounded-[2.5rem] p-10 md:p-12 text-white relative overflow-hidden shadow-2xl shadow-gray-900/20 h-full flex flex-col justify-between group">
            <div class="relative z-10">
              <h2 class="text-3xl font-black uppercase tracking-tighter mb-10 italic">Dane <span class="text-blue-500">Klubu</span></h2>
              <div class="space-y-8">
                <ContactInfoItem icon="map-pin" label="Adres korespondencyjny" value="ul. Przykładowa 1<br/>00-000 Kielce" />
                <ContactInfoItem icon="mail" label="Email" value="kontakt@example.com" href="mailto:kontakt@example.com" />
                <ContactInfoItem icon="phone" label="Telefon do zarządu" value="+48 000 000 000" />
              </div>
            </div>

            <div class="relative z-10 mt-16 pt-8 border-t border-gray-800">
              <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-4">Znajdź nas w sieci</h3>
              <div class="flex gap-4">
                <a href="#" class="bg-white/10 w-12 h-12 flex items-center justify-center rounded-xl hover:bg-blue-600 transition-colors"><i class="ti ti-brand-facebook text-2xl"></i></a>
                <a href="#" class="bg-white/10 w-12 h-12 flex items-center justify-center rounded-xl hover:bg-pink-600 transition-colors"><i class="ti ti-brand-instagram text-2xl"></i></a>
              </div>
            </div>
            <div class="absolute -top-20 -right-20 w-80 h-80 bg-blue-600/30 rounded-full blur-[80px] pointer-events-none group-hover:bg-blue-500/40 transition-colors duration-700"></div>
          </div>
        </div>

        <div class="w-full lg:w-7/12">
          <div class="bg-white rounded-[2.5rem] p-10 md:p-12 shadow-xl shadow-gray-200/50 border border-gray-100">
            <h3 class="text-2xl font-black uppercase mb-8 text-gray-900">Wyślij wiadomość</h3>
            <ContactForm /> </div>
        </div>

      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-6xl text-center">
      <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter mb-4 italic text-gray-900">Gdzie <span class="text-blue-600">trenujemy?</span></h2>
      <p class="text-gray-500 mb-12 max-w-2xl mx-auto">TS Akwedukt Kielce nie ma jednego budynku – naszym stadionem jest całe miasto.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
        <LocationCard isPrimary icon="swimming" title="Pływalnie" description="Kieleckie baseny kryte. Główna baza do szlifowania formy." />
        <LocationCard icon="bike" title="Szosa" description="Świętokrzyskie trasy rowerowe i bezpieczne pętle." />
        <LocationCard icon="run" title="Stadion LA" description="Stadion lekkoatletyczny i kieleckie parki." />
      </div>
    </div>
  </section>
</BaseLayout>
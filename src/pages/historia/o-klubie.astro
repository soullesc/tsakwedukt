---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionInfo from '../../components/SectionInfo.astro';

const stats = [
  { label: "Lat tradycji", value: "30+" },
  { label: "Wychowanków", value: "500+" },
  { label: "Medali MP", value: "120+" },
];
---

<BaseLayout title="O klubie - TS Akwedukt">
  <section class="relative py-20 overflow-hidden bg-white">
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl">
        <span class="text-blue-600 font-bold uppercase tracking-widest text-sm mb-4 block text-left">Poznaj nas bliżej</span>
        <h1 class="text-7xl font-black text-gray-900 leading-none mb-8 italic uppercase tracking-tighter text-left">
          Pasja. <br/> <span class="text-blue-600">Wytrzymałość.</span> <br/> Rodzina.
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed border-l-4 border-gray-100 pl-6 text-left">
          TS Akwedukt Kielce to nie tylko klub sportowy. To miejsce, gdzie od 1994 roku kształtujemy charaktery i pomagamy osiągać niemożliwe.
        </p>
      </div>
    </div>
    <div class="absolute top-0 right-0 w-1/2 h-full bg-blue-50 -skew-x-12 translate-x-1/4 z-0"></div>
  </section>

  <section class="py-12 bg-gray-900 text-white skew-y-1">
    <div class="container mx-auto px-4 -skew-y-1">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
        {stats.map(stat => (
          <div class="group">
            <div class="text-6xl font-black text-blue-500 mb-2 group-hover:scale-110 transition-transform">
              {stat.value}
            </div>
            <div class="text-gray-400 uppercase tracking-widest text-sm font-bold">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 space-y-32">
    
    <div class="container mx-auto px-4 flex flex-col md:flex-row items-center gap-16">
      <div class="w-full md:w-1/2 relative">
        <div class="absolute -top-4 -left-4 w-full h-full border-2 border-blue-600 rounded-2xl"></div>
        <img 
          src="/images/triatlon-o-klubie.jpg" 
          alt="Trening pływacki TS Akwedukt" 
          class="relative z-10 rounded-2xl shadow-2xl w-full h-auto object-cover"
        />
      </div>
      <div class="w-full md:w-1/2 text-left">
        <h2 class="text-4xl font-black mb-6 uppercase italic text-left">Gdzie woda spotyka ogień</h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-6 text-left">
          Zaczynaliśmy na kieleckich basenach, marząc o wielkim triathlonie. Dziś nasi zawodnicy startują w najdalszych zakątkach świata, ale serce klubu wciąż bije w Kielcach.
        </p>
        <div class="flex flex-wrap gap-4">
            <div class="bg-blue-100 text-blue-700 px-4 py-2 rounded-lg font-bold text-sm">Pływanie</div>
            <div class="bg-blue-100 text-blue-700 px-4 py-2 rounded-lg font-bold text-sm">Kolarstwo</div>
            <div class="bg-blue-100 text-blue-700 px-4 py-2 rounded-lg font-bold text-sm">Bieganie</div>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 flex flex-col md:flex-row-reverse items-center gap-16">
        <div class="w-full md:w-1/2 relative">
          <div class="absolute -bottom-4 -right-4 w-full h-full border-2 border-blue-600 rounded-2xl"> </div>
          <img 
            src="/images/triatlon-o-klubie-1.jpg" 
            alt="Zawody triathlonowe TS Akwedukt" 
            class="relative z-10 rounded-2xl shadow-2xl w-full h-auto object-cover"
          />
        </div>
        <div class="w-full md:w-1/2 text-left">
          <h2 class="text-4xl font-black mb-6 uppercase italic text-left">Wychowujemy mistrzów</h2>
          <p class="text-gray-600 text-lg leading-relaxed text-left">
            Nasz system szkolenia skupia się nie tylko na wynikach, ale na zrównoważonym rozwoju. W Akwedukcie wierzymy, że sport to najlepsza lekcja życia dla dzieci i młodzieży.
          </p>
        </div>
      </div>

  </section>

    <SectionInfo 
  title=" Zacznij swoją przygodę z" 
  blueTitle="triathlonem!" 
  description="Trwa nabór do sekcji triathlonowej dla dzieci i doroslych. Sprawdź wolne miejsca!"
  buttonText=" Dołącz do nas"
  buttonHref="/kontakt"
  />
</BaseLayout>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionInfo from '../../components/SectionInfo.astro';

const boardMembers = [
  {
    role: "Prezes Klubu",
    name: "Imię Nazwisko",
    description: "Serce i umysł Akweduktu. Od lat dba o to, by klub nieustannie się rozwijał i zapewniał zawodnikom najlepsze warunki do treningu.",
    email: "prezes@example.com"
  },
  {
    role: "Wiceprezes",
    name: "Imię Nazwisko",
    description: "Odpowiada za strategię sportową i koordynację kluczowych projektów klubu na szczeblu krajowym.",
    email: "wiceprezes@example.com"
  },
  {
    role: "Skarbnik / Sekretarz",
    name: "Imię Nazwisko",
    description: "Czuwa nad stabilnością finansową klubu oraz sprawami administracyjnymi, dbając o każdy szczegół organizacyjny.",
    email: "biuro@example.com"
  }
];
---

<BaseLayout title="Zarząd - TS Akwedukt">
  <section class="relative py-20 bg-white overflow-hidden">
    <div class="container mx-auto px-4 relative z-10 text-left">
      <span class="text-blue-600 font-bold uppercase tracking-[0.2em] text-xs mb-4 block">Ludzie Akweduktu</span>
      <h1 class="text-6xl md:text-8xl font-black text-gray-900 leading-none uppercase tracking-tighter mb-8 italic">
        Zarząd <br/><span class="text-blue-600">Klubu.</span>
      </h1>
      <p class="max-w-2xl text-xl text-gray-500 font-medium leading-relaxed border-l-4 border-gray-100 pl-6">
        Pasja do sportu to fundament, ale stabilny rozwój wymaga profesjonalnego zarządzania. Poznaj osoby, które stoją za sukcesami organizacyjnymi TS Akwedukt Kielce.
      </p>
    </div>
    <div class="absolute top-0 right-0 w-1/3 h-full bg-blue-50/50 -skew-x-12 translate-x-1/4"></div>
  </section>

  <section class="py-12 bg-gray-50/30">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {boardMembers.map(member => (
          <div class="group bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300">
            
            <div class="bg-blue-50 text-blue-600 text-[10px] font-black uppercase tracking-wider px-3 py-1.5 rounded-lg inline-block mb-4">
              {member.role}
            </div>

            <h3 class="text-2xl font-black text-gray-900 mb-3 tracking-tighter uppercase">
              {member.name}
            </h3>

            <p class="text-gray-500 leading-tight mb-6 text-sm">
              {member.description}
            </p>

            <div class="pt-4 border-t border-gray-50">
              <a href={`mailto:${member.email}`} class="text-blue-600 font-bold text-[11px] uppercase tracking-widest flex items-center gap-2 hover:text-blue-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                Kontakt
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionInfo />
</BaseLayout>
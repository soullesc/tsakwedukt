---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';

interface NewsModule {
  frontmatter: {
    title: string;
    date: string;
    author: string;
    excerpt: string;
    image: string;
  };
  url: string; 
}

const newsFiles = import.meta.glob<NewsModule>('./news/*.md', { eager: true });
const news = Object.values(newsFiles);

const sortedNews = news.sort((a, b) => 
  new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
);
---

<BaseLayout title="Strona Główna - TS Akwedukt">
  
  <article class="relative w-full h-[400px] rounded-2xl overflow-hidden mb-12 group shadow-lg bg-gray-900">
    
    <img 
      src="/images/index-banner.jpg" 
      alt="Trening pływacki" 
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
    />
    
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/60 to-transparent"></div>
    
    <div class="absolute bottom-0 left-0 p-6 md:p-8 w-full z-10">
      <div class="flex items-center gap-3 mb-3 text-sm text-gray-200 font-medium">
        <span class="bg-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-sm">
          Nowość
        </span>
        <span>04 Marca 2026</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-white mb-3 leading-tight">
        <a href="#" class="hover:text-blue-400 transition-colors before:absolute before:inset-0">
          Rozpoczynamy nowy sezon startowy!
        </a>
      </h1>
      <p class="text-gray-200 max-w-2xl line-clamp-2 md:text-lg">
        Po długich miesiącach intensywnych treningów zimowych, nasi zawodnicy są w pełni gotowi na pierwsze wyzwania w tym roku. Zobacz nasz pełny harmonogram startów.
      </p>
    </div>
  </article>

  <div class="space-y-6">
    <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-6">
      <h2 class="text-2xl font-black uppercase italic tracking-tighter text-gray-900">Najnowsze wiadomości</h2>
    </div>

    {sortedNews.map((newsItem) => (
      <NewsCard 
        title={newsItem.frontmatter.title}
        date={new Date(newsItem.frontmatter.date)}
        author={newsItem.frontmatter.author}
        excerpt={newsItem.frontmatter.excerpt}
        image={newsItem.frontmatter.image}
        url={newsItem.url || '#'} 
      />
    ))}

  </div>

</BaseLayout>